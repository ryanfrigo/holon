{
  "name": "@holon/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "app": "electron-vite build && electron-builder --mac dir --config.mac.identity=null && open dist/mac*/Holon.app"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "Holon",
  "build": {
    "appId": "dev.holon.app",
    "productName": "Holon",
    "electronVersion": "44.6.0",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    },
    "npmRebuild": false
  }
}
